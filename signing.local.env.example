# Your own signing settings for building Henge on your Mac and installing it on your iPhone or iPad.
# Copy this file to signing.local.env (in the same folder) and fill it in. signing.local.env is in
# .gitignore: it stays on your Mac and is never committed. Paths may be absolute or relative to the repo.
# Used by tools/ios/build.sh, tools/ios/sign.sh and tools/ios/install.sh.

# --- The iOS app ---
# Your 10-character Apple Team ID (developer.apple.com > Membership, or the profile's TeamIdentifier).
HENGE_TEAM_ID=
# Your signing certificate: its name ("Apple Development: ...") or SHA-1, from
#   security find-identity -v -p codesigning
HENGE_SIGN_IDENTITY=
# The app's bundle id, one your provisioning profile allows (for example com.example.henge).
HENGE_BUNDLE_ID=
# The JIT helper extension's bundle id (default: $HENGE_BUNDLE_ID.JITHelper).
HENGE_HELPER_BUNDLE_ID=
# Provisioning profiles for the app and for the helper (.mobileprovision files).
HENGE_APP_PROFILE=
HENGE_HELPER_PROFILE=
# Optional: entitlements files to sign with. Left empty, sign.sh writes them from
# ios/Henge/Henge.entitlements and your team and bundle ids. A free (personal) team can't sign
# extended virtual addressing: set HENGE_BASE_ENTITLEMENTS=ios/Henge/Henge.personal.entitlements.
HENGE_APP_ENTITLEMENTS=
HENGE_HELPER_ENTITLEMENTS=
HENGE_BASE_ENTITLEMENTS=
# The device to install on: its UDID or name, as `xcrun devicectl list devices` shows it.
HENGE_DEVICE=

# --- The Mac helper tools (henge-agent, "Install Henge Tools") ---
# The folder holding the self-signed identity tools/ios/make-tools-identity.sh makes (default .signing/).
# With it, macOS keeps the helper's Accessibility permission across builds. Without it the tools are
# signed ad hoc and each new build has to be allowed again. No Apple account is used for these.
HENGE_TOOLS_DIR=

# --- Build ---
# Where build.sh keeps Husk, StikJIT and the built app (default build/ios).
HENGE_WORK=
